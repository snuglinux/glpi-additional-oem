pkgname=glpi-additional-oem
pkgver=0.1.2
pkgrel=1
pkgdesc="Generate OEM-based GLPI Agent inventory identity data for systems with invalid DMI serials or UUIDs"
arch=('any')
url="https://github.com/snuglinux/glpi-additional-oem"
license=('GPL-3.0-or-later')

depends=(
  'bash'
  'glpi-agent'
  'ethtool'
)

backup=(
  'etc/glpi-agent/conf.d/20-additional-oem.cfg'
  'etc/glpi-additional-oem/bad-uuids.list'
  'etc/glpi-additional-oem/bad-values.list'
)

install="${pkgname}.install"

source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/snuglinux/glpi-additional-oem/archive/refs/tags/${pkgver}.tar.gz"
)

sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm0755 src/glpi-additional-oem \
    "${pkgdir}/usr/lib/glpi-agent/glpi-additional-oem"

  install -Dm0755 src/glpi-additional-oem-disable-old \
    "${pkgdir}/usr/lib/glpi-agent/glpi-additional-oem-disable-old"

  install -Dm0644 config/20-additional-oem.cfg \
    "${pkgdir}/etc/glpi-agent/conf.d/20-additional-oem.cfg"

  install -Dm0644 config/bad-uuids.list \
    "${pkgdir}/etc/glpi-additional-oem/bad-uuids.list"

  install -Dm0644 config/bad-values.list \
    "${pkgdir}/etc/glpi-additional-oem/bad-values.list"

  install -Dm0644 systemd/10-additional-oem.conf \
    "${pkgdir}/usr/lib/systemd/system/glpi-agent.service.d/10-additional-oem.conf"

  install -Dm0644 README.md \
    "${pkgdir}/usr/share/doc/glpi-additional-oem/README.md"

  install -Dm0644 LICENSE \
    "${pkgdir}/usr/share/licenses/glpi-additional-oem/LICENSE"
}
